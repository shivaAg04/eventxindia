rules_version = '2';

// EventXIndia Platform — Firestore Security Rules
//
// These rules are the backend trust boundary for the current Firebase backend.
// They mirror the invariants enforced in the pure domain layer (defense in depth)
// so a compromised or buggy client cannot violate them.
//
// IMPORTANT: The Firebase Admin SDK (used by Cloud Functions / trusted services
// such as EarningsService, MetricsService, NotificationService) bypasses these
// rules entirely. Therefore any field documented as "trusted backend only"
// (e.g. vendors.approvalStatus, attendance.accrued, earnings.*, metrics/global,
// notification delivery fields) is protected here simply by DENYING all client
// writes to it. The trusted backend still writes it via the Admin SDK.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------------

    // A request is authenticated when it carries a verified auth token.
    function isSignedIn() {
      return request.auth != null;
    }

    // True when the signed-in user owns the document keyed by `uid`.
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // The requesting user's role, read from their users/{uid} document.
    // Returns null if the user document does not exist.
    function userRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    // The approvalStatus of the requesting vendor, read from vendors/{uid}.
    function requesterVendorApprovalStatus() {
      return get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.approvalStatus;
    }

    function requesterIsApprovedVendor() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/vendors/$(request.auth.uid))
        && requesterVendorApprovalStatus() == 'Approved';
    }

    // Status of an event, used by application/attendance rules.
    function eventStatus(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.status;
    }

    // The owning vendor of an event.
    function eventOwner(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.vendorId;
    }

    // --- Staff (vendor team) helpers -------------------------------------
    function isStaff() {
      return userRole() == 'staff';
    }

    // The parent vendor a staff member acts for, and their assigned role,
    // both read from the requester's users/{uid} document.
    function staffVendorId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vendorId;
    }
    function staffRoleName() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffRole;
    }
    function staffCanApplicants() {
      return isStaff() && staffRoleName() in ['Manager', 'ApplicantReviewer'];
    }
    function staffCanAttendance() {
      return isStaff() && staffRoleName() in ['Manager', 'AttendanceStaff'];
    }

    // True when a field is unchanged between the existing doc and the incoming write.
    function unchanged(field) {
      return resource.data[field] == request.resource.data[field];
    }

    // True when the incoming write does NOT introduce the given field at all.
    function absent(field) {
      return !(field in request.resource.data);
    }

    // ---------------------------------------------------------------------
    // users/{uid}  — a user may read/write only their own document.
    // `role` is fixed at registration; clients cannot change it afterward
    // (role changes require Admin / trusted backend). `deviceTokens` is
    // owner-writable (R13.7).
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Create: only for self. Role is either a self-registered student/vendor,
      // OR 'staff' when a matching staff invite exists for this vendor + the
      // requester's verified phone (staff self-provision on first login). Admin
      // accounts are provisioned by the trusted backend.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && (
          request.resource.data.role in ['student', 'vendor']
          || (
            request.resource.data.role == 'staff'
            && exists(/databases/$(database)/documents/staff/$(
                 request.resource.data.vendorId + '_'
                 + request.auth.token.phone_number.replace('\\+', '')))
          )
        );

      // Update: only self. Role must not change, EXCEPT the same staff
      // self-provision path (a merge-write on first login may land as update).
      allow update: if isOwner(uid)
        && (
          unchanged('role')
          || (
            request.resource.data.role == 'staff'
            && exists(/databases/$(database)/documents/staff/$(
                 request.resource.data.vendorId + '_'
                 + request.auth.token.phone_number.replace('\\+', '')))
          )
        );

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // students/{uid}  — owner may create/read/update own profile.
    // Admin may read all (R6.4). An approved vendor may read student profiles
    // so they can review an applicant's full detail (the UI hides the phone).
    // ---------------------------------------------------------------------
    match /students/{uid} {
      allow read: if isOwner(uid) || isAdmin() || requesterIsApprovedVendor()
        || staffCanApplicants();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // vendors/{uid}  — owner may create/read/update own profile.
    // `approvalStatus` is NOT client-writable beyond the initial Pending value:
    //  - On create it must be exactly "Pending" (R2.9: no self-grant of Approved).
    //  - On update it must remain unchanged (R6.1–6.3: only Admin / trusted
    //    backend may move Pending -> Approved/Rejected, via the Admin SDK which
    //    bypasses these rules).
    // Admin may read all (R6.5).
    // ---------------------------------------------------------------------
    match /vendors/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.approvalStatus == 'Pending';

      // Owner may edit their profile but can never change approvalStatus.
      // An Admin may change approvalStatus (approve/reject) but not the
      // vendor's identity (uid); role changes stay Admin-only (R6.1–R6.3).
      allow update: if (isOwner(uid) && unchanged('approvalStatus'))
        || (isAdmin() && unchanged('uid'));

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // events/{eventId}
    //  - create: only by the owning vendor (auth.uid == vendorId) AND only when
    //    that vendor is Approved (R2.10, R5.1); status must start as "Active".
    //  - update: only by the owning vendor (R5.9). vendorId is immutable.
    //    (startCode/endCode are part of the doc and writable by the owner.)
    //  - read: any authenticated user (clients filter to Active events; Admin
    //    reads all — R8.1, R6.6).
    //  - delete: owning vendor only.
    // ---------------------------------------------------------------------
    match /events/{eventId} {
      allow read: if isSignedIn();

      // A vendor creates their own event as UNPUBLISHED: it must start Active in
      // lifecycle but Pending admin approval, so a vendor can never self-publish
      // an event to students.
      allow create: if isSignedIn()
        && request.resource.data.vendorId == request.auth.uid
        && requesterIsApprovedVendor()
        && request.resource.data.status == 'Active'
        && request.resource.data.approvalStatus == 'Pending';

      // The owning vendor may edit their event but MUST NOT change the moderation
      // gate — only an admin can approve/reject (publish) an event.
      allow update: if isSignedIn()
        && resource.data.vendorId == request.auth.uid
        && unchanged('vendorId')
        && unchanged('approvalStatus');

      // An admin may moderate any event (set approvalStatus) without owning it;
      // the vendor id is fixed.
      allow update: if isAdmin()
        && unchanged('vendorId');

      // Staff of the owning vendor may edit operational fields (approved count
      // on applicant approval, attendance codes) but never the vendor id, the
      // lifecycle status, or the moderation gate.
      allow update: if (staffCanApplicants() || staffCanAttendance())
        && resource.data.vendorId == staffVendorId()
        && unchanged('vendorId')
        && unchanged('status')
        && unchanged('approvalStatus');

      allow delete: if isSignedIn()
        && resource.data.vendorId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // applications/{applicationId}  (doc id == "{eventId}_{studentId}")
    //  - create: only by the owning student, with a matching composite id, only
    //    when the target event is Active, and status must be "Pending".
    //    Firestore `create` fails if the doc already exists, so this also
    //    enforces dedupe / no duplicate applications (R9.2).
    //  - update (decision): only by the owning event's vendor, only a
    //    Pending -> Approved/Rejected transition (R5.4, R5.5, R9.3–9.5).
    //    Students cannot change their own application status.
    //  - read: the owning student or the owning event's vendor; Admin reads all.
    // ---------------------------------------------------------------------
    match /applications/{applicationId} {
      // A `get` of a non-existent doc has a null `resource`; allow it for any
      // signed-in user (it simply returns nothing) so the client's
      // create-if-absent transaction can check existence before writing. Reads
      // of an EXISTING application stay restricted to the owning student, the
      // owning event's vendor, or an Admin.
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.studentId == request.auth.uid
        || eventOwner(resource.data.eventId) == request.auth.uid
        || (staffCanApplicants()
            && eventOwner(resource.data.eventId) == staffVendorId())
        || isAdmin()
      );

      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && applicationId == request.resource.data.eventId + '_' + request.resource.data.studentId
        && request.resource.data.status == 'Pending'
        && eventStatus(request.resource.data.eventId) == 'Active';

      // Decision: the owning vendor OR a staff member of that vendor with
      // applicant permission. Pending -> Approved/Rejected.
      allow update: if isSignedIn()
        && (
          eventOwner(resource.data.eventId) == request.auth.uid
          || (staffCanApplicants()
              && eventOwner(resource.data.eventId) == staffVendorId())
        )
        && resource.data.status == 'Pending'
        && request.resource.data.status in ['Approved', 'Rejected']
        && unchanged('eventId')
        && unchanged('studentId');

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // attendance/{attendanceId}  (doc id == "{eventId}_{studentId}")
    //  - The owning student may create/update check-in/out fields.
    //  - `accrued` is NOT client-writable (trusted backend only) — protecting
    //    exactly-once earnings (R11.1, R11.2). On create it must be absent (or
    //    the trusted backend sets it later); on update it must not be introduced
    //    or changed by the client.
    //  - read: owning student, owning event vendor, or Admin.
    // ---------------------------------------------------------------------
    match /attendance/{attendanceId} {
      // A `get` of a non-existent doc has a null `resource`; allow it for any
      // signed-in user (it returns nothing) so the client's create-if-absent
      // check-in transaction can test existence before writing. Reads of an
      // EXISTING record stay restricted to the owning student, the owning
      // event's vendor, or an Admin.
      // An APPROVED vendor (or a staff member reviewing applicants for one) may
      // also read any student's records, so the applicant detail screen can show
      // that candidate's track record — how many events they turned up to and
      // how many they completed (R5.3, R5.4). Firestore has no field-level read
      // rules, so this necessarily exposes the check-in/out times and geo behind
      // those counts; the alternative is the trusted
      // `studentStats/{studentId}` aggregate (Cloud Functions
      // `recomputeStudentStats*`), which exposes only the two counts. Tighten
      // this back to the owning vendor when that aggregator is deployed.
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.studentId == request.auth.uid
        || eventOwner(resource.data.eventId) == request.auth.uid
        || (staffCanAttendance()
            && eventOwner(resource.data.eventId) == staffVendorId())
        || requesterIsApprovedVendor()
        || staffCanApplicants()
        || isAdmin()
      );

      // Student creates their own record; cannot set `accrued`.
      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && attendanceId == request.resource.data.eventId + '_' + request.resource.data.studentId
        && absent('accrued');

      // Student updates check-in/out; `accrued` must remain exactly as stored
      // (i.e. the client cannot add or change it).
      allow update: if isSignedIn()
        && resource.data.studentId == request.auth.uid
        && unchanged('eventId')
        && unchanged('studentId')
        && (
          // accrued not present before and not introduced now, OR
          (!('accrued' in resource.data) && absent('accrued'))
          // accrued present before and left unchanged.
          || (('accrued' in resource.data) && unchanged('accrued'))
        );

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // earnings/{studentId}
    //  - read by the owning student and Admin.
    //  - NO client writes — written only by the trusted EarningsService via the
    //    Admin SDK (R11.1, R11.2).
    // ---------------------------------------------------------------------
    match /earnings/{studentId} {
      allow read: if isOwner(studentId) || isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // withdrawals/{withdrawalId}
    //  - A student creates their own request; it must start `Pending` and carry
    //    no decision. Read by the owning student or an Admin.
    //  - Only an Admin decides (updates `status`/`decidedAt`); the immutable
    //    identity/amount fields must not change. This is the sole path that can
    //    move a request out of `Pending`, so a client can never self-approve.
    // ---------------------------------------------------------------------
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid || isAdmin()
      );

      allow create: if isSignedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'Pending'
        && !('decidedAt' in request.resource.data);

      allow update: if isAdmin()
        && unchanged('studentId')
        && unchanged('amountMinorUnits')
        && unchanged('createdAt');

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // reports/{reportId}
    //  - create by a Student or Vendor for their own submission, restricted to
    //    the categories permitted for their role.
    //  - read by Admin only (R12.6).
    //  - immutable after creation by clients.
    // ---------------------------------------------------------------------
    match /reports/{reportId} {
      allow read: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.submitterId == request.auth.uid
        && (
          (request.resource.data.submitterRole == 'student'
            && userRole() == 'student'
            && request.resource.data.category in ['FakeEvent', 'VendorIssue'])
          ||
          (request.resource.data.submitterRole == 'vendor'
            && userRole() == 'vendor'
            && request.resource.data.category in ['NoShow', 'Misbehavior'])
        );

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // notifications/{notificationId}
    //  - Recipients may read their own notifications.
    //  - NO client writes: notifications are created by triggers and their
    //    delivery fields (deliveryStatus, attemptCount, lastAttemptAt) are owned
    //    by the trusted NotificationService via the Admin SDK (R12.6 / R13.x).
    // ---------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // metrics/{docId}  (e.g. metrics/global)
    //  - read by Admin only.
    //  - NO client writes — written only by the trusted MetricsService via the
    //    Admin SDK.
    // ---------------------------------------------------------------------
    match /metrics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // studentStats/{studentId}
    //  - A student's aggregated track record: how many events they were
    //    approved for and how many they completed attendance for. Recomputed by
    //    the trusted `recomputeStudentStats*` Cloud Functions on any
    //    application/attendance write.
    //  - read: the student themselves, any APPROVED vendor (they judge an
    //    applicant's history while reviewing them — the same access the
    //    `ratings` collection already grants), a staff member reviewing
    //    applicants for their vendor, or an Admin. Only the two counters live
    //    here, never the underlying events, times, or geo.
    //  - NO client writes — the counters must be tamper-proof, so they are
    //    written only via the Admin SDK.
    // ---------------------------------------------------------------------
    match /studentStats/{studentId} {
      allow read: if isOwner(studentId)
        || requesterIsApprovedVendor()
        || staffCanApplicants()
        || isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // authThrottle/{phone}
    //  - OTP throttle/lockout bookkeeping is trusted backend state. No client
    //    access (the client never reads or writes it directly).
    // ---------------------------------------------------------------------
    match /authThrottle/{phone} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------------
    // ratings/{eventId_studentId}
    //  - A vendor rates a student for an event once the student's check-out is
    //    complete. Ratings are one-time and immutable.
    //  - create: only by the event's owning vendor (and only an Approved
    //    vendor), with a composite id and matching eventId/studentId, a
    //    vendorId equal to the author, and a whole-star score in 1..5.
    //  - update/delete: never (one-time; locked after creation).
    //  - read: the rated student, any approved vendor (so a vendor reviewing an
    //    applicant can see the candidate's overall average rating — a query by
    //    studentId spans events the vendor does not own), or an Admin.
    // ---------------------------------------------------------------------
    match /ratings/{ratingId} {
      allow read: if isSignedIn() && (
        resource == null
        || resource.data.studentId == request.auth.uid
        || requesterIsApprovedVendor()
        || (isStaff() && eventOwner(resource.data.eventId) == staffVendorId())
        || isAdmin()
      );

      // The rating is created either by the owning approved vendor, or by a
      // staff member (attendance permission) of that vendor. In both cases the
      // stored vendorId is the owning vendor's uid.
      allow create: if isSignedIn()
        && (
          (requesterIsApprovedVendor()
              && request.resource.data.vendorId == request.auth.uid
              && eventOwner(request.resource.data.eventId) == request.auth.uid)
          || (staffCanAttendance()
              && request.resource.data.vendorId == staffVendorId()
              && eventOwner(request.resource.data.eventId) == staffVendorId())
        )
        && ratingId == request.resource.data.eventId + '_'
            + request.resource.data.studentId
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;

      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // config/{docId}  (e.g. config/platform)
    //  - Platform-wide settings (the commission percentage). Any signed-in user
    //    may read it (a vendor reads the current rate when creating an event to
    //    snapshot onto it); only an Admin may write it.
    // ---------------------------------------------------------------------
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // staff/{staffId}  — a vendor's staff roster. Doc id is
    // "{vendorId}_{phone}". The owning vendor manages their own staff; the
    // invited person may read their own invite (matched by verified phone) so
    // they can resolve their vendor/role at login; admin can read all.
    // ---------------------------------------------------------------------
    match /staff/{staffId} {
      // `resource == null` permits the existence-check read the create
      // transaction performs on a not-yet-created doc (reading a missing doc
      // leaks nothing); otherwise scope reads to the owner, the invited person
      // (by verified phone), or an admin.
      allow read: if isSignedIn() && (
             resource == null
          || resource.data.vendorId == request.auth.uid
          || resource.data.phone == request.auth.token.phone_number
          || isAdmin()
        );

      // The owner may create a staff entry for themselves (their own roster).
      // Approval is not required — an unapproved vendor may still set up staff;
      // staff can't act until the vendor's events exist and are approved anyway.
      allow create: if isSignedIn()
        && request.resource.data.vendorId == request.auth.uid;

      // The owning vendor may edit/remove their staff. The invited person may
      // also update their own invite (matched by verified phone) to self-link
      // their uid + active flag on first login.
      allow update: if isSignedIn() && (
             resource.data.vendorId == request.auth.uid
          || resource.data.phone == request.auth.token.phone_number
        );
      allow delete: if isSignedIn()
        && resource.data.vendorId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // Default deny for any collection not explicitly matched above.
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
