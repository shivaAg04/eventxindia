rules_version = '2';

// Firebase Storage security rules for EventXIndia (R1.9, R14.1).
//
// Profile photos live at `profile_photos/{uid}`. A signed-in user may read any
// profile photo (so vendors/admins can view applicants), but may only write
// their own. Everything else is denied by default.
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_photos/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Default deny for any path not explicitly matched above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
